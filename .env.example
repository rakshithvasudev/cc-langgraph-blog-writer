# API Settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# LLM Settings
LLM_PROVIDER=anthropic  # or "openai"
ANTHROPIC_API_KEY=your-anthropic-api-key-here

LLM_MODEL=claude-sonnet-4-20250514
LLM_TEMPERATURE=0.7

# Tavily Settings
TAVILY_API_KEY=your-tavily-api-key-here
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=5

# Research Defaults
DEFAULT_MAX_ITERATIONS=7
MIN_ITERATIONS=5
MAX_ITERATIONS=15

# Checkpointer Settings
USE_POSTGRES=false
POSTGRES_URI=postgresql://user:pass@localhost:5432/research_agent

# Logging
LOG_LEVEL=INFO
